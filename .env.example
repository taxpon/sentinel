# Sentinel configuration.
#
#   cp .env.example .env     then fill in every value left blank below.
#
# This file is the canonical list of variables; the table in docs/09-operations.md documents what
# each one is for. tests/test_env_example.py fails if the two drift apart.
#
# Blank values are required and have no sensible default. Everything else is shown with the
# documented default, so it only needs changing to depart from it.

# --- Devin ---------------------------------------------------------------------------------------
DEVIN_API_BASE=https://api.devin.ai
# Service-user token, "cog_" prefix. Never commit the filled-in .env.
DEVIN_API_TOKEN=
DEVIN_ORG_ID=
# Optional: unlocks the enterprise metrics panel. Leave blank to use the locally derived figures.
DEVIN_ENTERPRISE_ID=
# JSON map of issue class to playbook id, e.g. {"security":"playbook-...","bug":"playbook-..."}
DEVIN_PLAYBOOK_IDS=
# JSON array, written by `make bootstrap-devin`.
DEVIN_KNOWLEDGE_IDS=

# --- GitHub --------------------------------------------------------------------------------------
# Fine-grained PAT scoped to TARGET_REPO: issues rw, pull requests rw, contents read.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
TARGET_REPO=taxpon/superset
TARGET_BASE_BRANCH=master
AUTOFIX_LABEL=devin:autofix
CI_REQUIRED_CHECK_NAME=devin-autofix-ci
CI_WORKFLOW_PATH=.github/workflows/devin-autofix-ci.yml

# --- Database ------------------------------------------------------------------------------------
# Compose overrides this for the containers. For host-side test runs use:
#   postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel
DATABASE_URL=

# --- Policy --------------------------------------------------------------------------------------
MAX_CONCURRENT_SESSIONS=3
DAILY_ACU_BUDGET=100
MAX_FIX_CYCLES=3
MAX_JOB_ATTEMPTS=5
JOB_LEASE_TIMEOUT_SECONDS=900
POLL_INTERVAL_SECONDS=20

# --- Reporting -----------------------------------------------------------------------------------
# Set from your own contract. It only scales the cost panel; it is not billed against.
ACU_UNIT_COST_USD=2.25
LOG_LEVEL=info
